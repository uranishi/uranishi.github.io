{% comment %}
  Research grant entries in a single list; PI rows show a role badge.
{% endcomment %}
{% assign cv_locale = include.locale | default: page.lang | default: 'en' %}
{% assign funding_roles_i18n = site.data.i18n[cv_locale].cv_funding_roles %}
